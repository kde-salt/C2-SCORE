# Copy to .env and adjust. docker compose reads .env automatically.
# ---------------------------------------------------------------------------

# Neo4j password. Only takes effect on the FIRST start with an empty data
# volume; to change it later, run `docker compose down -v` and start over.
C2_NEO4J_PASSWORD=password

# Directory holding the *.dump files downloaded from Google Drive
# (README section 1.5). Relative paths are resolved from the repository root.
DUMP_DIR=./edbt_dumps

# Host ports for the Neo4j Browser and Bolt. Change these if something else
# on the host already listens on 7474/7687 (e.g. a Neo4j Desktop instance).
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Neo4j memory. Raise both for the DBpedia-scale experiments (EQ2 Table 3);
# the sum must fit in the memory available to the Docker VM.
NEO4J_HEAP=8G
NEO4J_PAGECACHE=8G

# Upper bound on the number of databases. The experiments need well over the
# 100 default; 150 covers every experiment in the paper.
NEO4J_MAX_DATABASES=150

# JVM heap and code cache for the PG-HIVE extraction (pghive profile only).
# The paper's Table 3 runs used PGHIVE_XMX=80G; lower it to fit your machine.
PGHIVE_XMX=8G
PGHIVE_CODECACHE=1G

# Linux hosts: match the container user to your host account so that files
# written into the repository (results/, logs/) stay owned by you:
#   sed -i "s/^HOST_UID=.*/HOST_UID=$(id -u)/; s/^HOST_GID=.*/HOST_GID=$(id -g)/" .env
# macOS hosts can leave these at the defaults.
HOST_UID=1000
HOST_GID=1000
